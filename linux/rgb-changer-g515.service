# Помощната програма на RGB Changer за Logitech G515 като потребителска услуга (тръгва с влизането в системата).
#
# Инсталиране (от папката на проекта):
#   mkdir -p ~/.local/bin ~/.config/rgb-changer ~/.config/systemd/user
#   cp linux/g515-helper.py ~/.local/bin/rgb-changer-g515
#   chmod +x ~/.local/bin/rgb-changer-g515
#   cp linux/rgb-changer-g515.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now rgb-changer-g515
#
# Файлът с цветовете (g515.json от сайта) отива в ~/.config/rgb-changer/.
# Дневник: journalctl --user -u rgb-changer-g515 -f
[Unit]
Description=RGB Changer: цветове по клавиши за Logitech G515

[Service]
ExecStart=/usr/bin/env python3 %h/.local/bin/rgb-changer-g515
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
