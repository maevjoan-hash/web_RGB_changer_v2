# Дава достъп на влезлия потребител до Logitech устройствата (USB, Lightspeed приемник и Bluetooth),
# за да може браузърът да ги отвори през WebHID. Без това Linux позволява достъп до /dev/hidraw* само на root.
#
# Инсталиране:
#   sudo cp 42-logitech-webhid.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# После изключи и включи мишката (или я свържи отново по Bluetooth).
#
# Номерът 42 е нарочно под 73, за да се приложи TAG+="uaccess" преди 73-seat-late.rules.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"
